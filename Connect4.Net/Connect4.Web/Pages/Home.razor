@page "/"
@using System.ComponentModel
@using CommunityToolkit.Mvvm.Input
@using Connect4.App.Models
@using Connect4.Engine
@using Connect4.Web.Services
@implements IDisposable
@inject MainViewModel Vm
@inject ShellDialogs Dialogs
@inject AppearanceStore AppearanceStore
@inject IJSRuntime JS

<PageTitle>@(string.IsNullOrEmpty(Vm.Title) ? "Connect 4 – Play Online" : Vm.Title)</PageTitle>

<ShellLayout Brand="Connect 4" Menus="_menus" Shortcuts="_shortcuts" Inert="@(Dialogs.Current is not null)" OnCommand="() => { }">
    <BoardArea>
        <Board Cells="Vm.Cells" NextDisc="Vm.NextDisc" Appearance="_appearance" OnPlay="Play" />
    </BoardArea>
    <SidePanels>
        <StatusPanel IsModified="Vm.IsStatusModified"
                     VariantBadge="@Vm.VariantBadgeText"
                     SettingBadge="@(Vm.IsGameSettingVisible ? Vm.SettingsBadgeText : null)"
                     StatusText="@Vm.TurnIndicatorText"
                     IsThinking="Vm.IsAiThinking"
                     First="@RedPlayer"
                     Second="@YellowPlayer"
                     Undo="Vm.UndoCommand" CanUndo="Vm.CanUndo"
                     Redo="Vm.RedoCommand" CanRedo="Vm.CanRedo"
                     MoveNow="@(Vm.IsVsComputer ? Vm.MoveNowCommand : null)" CanMoveNow="Vm.IsAiThinking" />

        @if (Vm.ShowAnalysis)
        {
            <AnalysisPanel Analysis="_analysis" />
        }

        <MoveHistoryPanel Rows="@HistoryRows" />
    </SidePanels>
</ShellLayout>

@code {
    private MenuDefinition[] _menus = [];
    private Dictionary<string, Func<Task>> _shortcuts = [];
    private AnalysisAdapter _analysis = default!;
    private Appearance _appearance = Appearance.Default;
    private bool _renderPending;

    private PlayerInfo RedPlayer => new(
        "Red", "red-dot", Vm.RedPlayerLabel, Vm.RedDiscsCount.ToString(), $"{Vm.RedDiscsLeft} left",
        Vm.IsClockVisible ? Vm.RedClockText : null, Vm.IsRedActiveTurn);

    private PlayerInfo YellowPlayer => new(
        "Yellow", "yellow-dot", Vm.YellowPlayerLabel, Vm.YellowDiscsCount.ToString(), $"{Vm.YellowDiscsLeft} left",
        Vm.IsClockVisible ? Vm.YellowClockText : null, Vm.IsYellowActiveTurn);

    private IReadOnlyList<MoveHistoryRow> HistoryRows =>
        [.. Vm.MoveHistoryList.Select(move =>
            new MoveHistoryRow(move.Round, move.RedMove, string.IsNullOrEmpty(move.YellowMove) ? null : move.YellowMove))];

    protected override void OnInitialized()
    {
        _appearance = AppearanceStore.Load();
        _analysis = new AnalysisAdapter(Vm.Analysis);

        _menus =
        [
            new("File",
            [
                new("New Game", Vm.NewGameCommand, "Ctrl+N"),
                new("Open...", Vm.OpenCommand, "Ctrl+O"),
                new("Save", Vm.SaveCommand, "Ctrl+S"),
                new("Save As...", Vm.SaveAsCommand),
            ]),
            new("Game",
            [
                new("vs Computer (Red)", new AsyncRelayCommand(() => Vm.StartNewGameWithMode(GameMode.HumanVsComputer)), IsChecked: () => Vm.IsHumanVsComputer, Radio: true),
                new("vs Computer (Yellow)", new AsyncRelayCommand(() => Vm.StartNewGameWithMode(GameMode.ComputerVsHuman)), IsChecked: () => Vm.IsComputerVsHuman, Radio: true),
                new("vs Human (Two players)", new AsyncRelayCommand(() => Vm.StartNewGameWithMode(GameMode.HumanVsHuman)), IsChecked: () => Vm.IsHumanVsHuman, Radio: true),
                new("Switch sides", Vm.SwitchSidesCommand, SeparatorBefore: true),
                new("Settings...", Vm.EditSettingsCommand, "F2", SeparatorBefore: true),
            ]),
            new("Options",
            [
                new("Analysis", Vm.ToggleAnalysisCommand, "Ctrl+A", IsChecked: () => Vm.IsAnalysisVisible),
                new("Sound", Vm.ToggleSoundCommand, IsChecked: () => Vm.IsSoundOn),
                BoardEntry("Blue Board", BoardStyle.Blue, separatorBefore: true),
                BoardEntry("Golden Oak Board", BoardStyle.GoldenOak),
                BoardEntry("Reddish Wood Board", BoardStyle.ReddishWood),
                new("3D Discs", ChangeAppearance(a => a with { Discs3D = !a.Discs3D }), IsChecked: () => _appearance.Discs3D, SeparatorBefore: true),
                new("Animate Drops", ChangeAppearance(a => a with { AnimateDrops = !a.AnimateDrops }), IsChecked: () => _appearance.AnimateDrops),
            ]),
            new("Help",
            [
                new("User guide", new RelayCommand(OpenUserGuide), "F1"),
                new("Rules & Documentation", new RelayCommand(OpenDocs), "Shift+F1"),
                new("About Connect 4...", Vm.AboutCommand),
            ]),
        ];

        _shortcuts = new()
        {
            ["n"] = () => ShellCommands.RunAsync(Vm.NewGameCommand),
            ["o"] = () => ShellCommands.RunAsync(Vm.OpenCommand),
            ["s"] = () => ShellCommands.RunAsync(Vm.SaveCommand),
            ["m"] = () => ShellCommands.RunAsync(Vm.MoveNowCommand),
            ["z"] = () => ShellCommands.RunAsync(Vm.UndoCommand),
            ["y"] = () => ShellCommands.RunAsync(Vm.RedoCommand),
            ["a"] = () => ShellCommands.RunAsync(Vm.ToggleAnalysisCommand),
            ["f1"] = () => Run(OpenUserGuide),
            ["shift+f1"] = () => Run(OpenDocs),
            ["f2"] = () => ShellCommands.RunAsync(Vm.EditSettingsCommand),
        };

        Vm.PropertyChanged += OnChanged;
        Dialogs.Changed += OnDialogChanged;
        foreach (CellViewModel cell in Vm.Cells)
        {
            cell.PropertyChanged += OnChanged;
        }
    }

    public void Dispose()
    {
        Vm.PropertyChanged -= OnChanged;
        Dialogs.Changed -= OnDialogChanged;
        foreach (CellViewModel cell in Vm.Cells)
        {
            cell.PropertyChanged -= OnChanged;
        }
    }

    private void OnChanged(object? sender, EventArgs e)
    {
        if (_renderPending)
        {
            return;
        }

        _renderPending = true;
        _ = InvokeAsync(async () =>
        {
            await Task.Yield();
            _renderPending = false;
            StateHasChanged();
        });
    }

    private void OnDialogChanged() => InvokeAsync(StateHasChanged);

    private void Play(int column) => Vm.PlayCommand.Execute(column);

    private void OpenUserGuide() => ((IJSInProcessRuntime)JS).InvokeVoid("open", BrainDocs.PageRoute("13-gui-and-settings"), "_blank", "noopener");

    private void OpenDocs() => ((IJSInProcessRuntime)JS).InvokeVoid("open", BrainDocs.PageRoute(""), "_blank", "noopener");

    private static Task Run(Action action)
    {
        action();
        return Task.CompletedTask;
    }

    private MenuEntry BoardEntry(string text, BoardStyle board, bool separatorBefore = false) =>
        new(text, ChangeAppearance(a => a with { Board = board }), IsChecked: () => _appearance.Board == board, Radio: true, SeparatorBefore: separatorBefore);

    private RelayCommand ChangeAppearance(Func<Appearance, Appearance> change) => new(() =>
    {
        _appearance = change(_appearance);
        AppearanceStore.Save(_appearance);
    });
}
